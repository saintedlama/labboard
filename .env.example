# labboard configuration
# Copy this file to .env to customize settings

# Host address to bind the HTTP server to.
# By default, labboard only binds to 127.0.0.1 for local/homelab safety.
# Set to 0.0.0.0 to expose across your local LAN or in container environments.
HOST=127.0.0.1

# HTTP port to listen on
PORT=8080

# Directory where the SQLite database file is stored
DATA_DIR=./data

# SQLite database file name
DB_NAME=labboard.db
